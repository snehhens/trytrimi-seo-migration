/*
  # Security Headers
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self' https://*.lovableproject.com https://*.lovable.app; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://*.lovableproject.com https://*.lovable.app https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://*.lovableproject.com https://*.lovable.app https://fonts.googleapis.com; font-src 'self' https://*.lovableproject.com https://*.lovable.app https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://*.lovableproject.com https://*.lovable.app https://www.google-analytics.com https://www.google.com; worker-src 'self' blob:; frame-ancestors 'none'
  
  # Cache Control & Compression
  Cache-Control: public, max-age=31536000, immutable, stale-while-revalidate=86400
  Accept-Encoding: gzip, br
  Vary: Accept-Encoding

/index.html
  # No cache for HTML
  Cache-Control: no-cache, must-revalidate, max-age=0
  Vary: Accept-Encoding

/sw.js
  # Service worker should not be cached
  Cache-Control: no-cache, no-store, must-revalidate

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept

/*.png
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  
/*.webp
  Cache-Control: public, max-age=31536000, immutable
